# Copy to server/.env (gitignored) or set as Windows user environment variables.
# Every value is optional for M0: the server boots without any of them.

# --- Server ---
PORT=3001
HOST=127.0.0.1
DB_FILE=data/hot.sqlite
HEARTBEAT_INTERVAL_SEC=30

# --- DeepSeek（分析：中文摘要和可信度。没有密钥时只走规则）---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- twitterapi.io (signup free credit only) ---
TWITTERAPI_IO_API_KEY=
TWITTER_DAILY_TWEET_CAP=150

# --- Search-result crawling (Sogou on; Google/DuckDuckGo auto-pause) ---
SEARCH_ENGINES=sogou,google,duckduckgo
SEARCH_MIN_INTERVAL_SEC=90
SEARCH_DAILY_CAP_PER_ENGINE=80
CRAWLER_CONTACT=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# --- Server酱 (ServerChan) ---
SERVERCHAN_SENDKEY=
